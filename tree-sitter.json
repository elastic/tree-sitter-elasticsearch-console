{
  "grammars": [
    {
      "name": "elasticsearch-console",
      "camelcase": "ElasticsearchConsole",
      "scope": "source.elasticsearch_console",
      "path": ".",
      "file-types": [
        "esc"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^elasticsearch_console$"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "ElasticsearchConsole grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-elasticsearch-console"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
