{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "elasticsearch_console",
      "camelcase": "ElasticsearchConsole",
      "title": "Elasticsearch Developer Console",
      "scope": "source.elasticsearch_console",
      "file-types": [
        "esc"
      ],
      "injection-regex": "^elasticsearch_console$",
      "class-name": "TreeSitterElasticsearchConsole"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "Elasticsearch developer console grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/elastic/tree-sitter-elasticsearch-console"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}