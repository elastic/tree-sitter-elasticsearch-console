{
  "name": "tree-sitter-elasticsearch-console",
  "version": "0.1.2",
  "description": "Elasticsearch developer console grammar for tree-sitter",
  "type": "module",
  "repository": "https://github.com/elastic/tree-sitter-elasticsearch-console",
  "license": "Apache-2.0",
  "author": {
    "name": "Josh Mock",
    "email": "joshua.mock@elastic.co"
  },
  "main": "bindings/node/index.js",
  "types": "bindings/node/index.d.ts",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "elasticsearch_console",
    "Elasticsearch",
    "Kibana"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "license-checker": "25.0.1",
    "prebuildify": "6.0.1",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.27.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "npm run test:bindings && npm run test:license-checker",
    "test:bindings": "node --test bindings/node/*_test.js",
    "test:license-checker": "license-checker --production --onlyAllow='MIT;Apache-2.0;Apache1.1;ISC;BSD-3-Clause;BSD-2-Clause;0BSD'",
    "build": "tree-sitter build ."
  }
}
